# Carbon Screen: make the panel backlight writable by the `video` group, so the
# helper (user carbon-net, which install_helper.sh adds to `video` only when a
# backlight device exists) can set brightness without root. Without this, POST
# /helper/display/brightness answers 403 and the app hides the brightness control.
#
# Installed by tools/helper/install_helper.sh, and only when /sys/class/backlight
# has a device (an HDMI panel has none). It then runs
#   sudo udevadm control --reload && sudo udevadm trigger --action=add -s backlight
# --action=add because these rules match ACTION=="add", and udevadm trigger sends
# "change" by default (udevadm(8)).
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
